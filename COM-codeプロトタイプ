#include <stdio.h>
#include <string.h>
#include <stdlib.h>
#include <unistd.h>

int count = 0; // グローバル変数例

void interpret_line(char *line) {
    if (line[0] == '/') {
        if (strncmp(line, "/print(", 7) == 0) {
            // /print(:Count is :Count)
            char buffer[256];
            strcpy(buffer, line + 7);
            char *p = strstr(buffer, ")");
            if (p) *p = 0; // 閉じカッコ削除

            // :Count を置換
            char output[256];
            char *pos = strstr(buffer, ":Count");
            if (pos) {
                *pos = 0;
                sprintf(output, "%s%d%s", buffer, count, pos + 6);
                printf("%s\n", output);
            } else {
                printf("%s\n", buffer);
            }
        }
        else if (strncmp(line, "/wait(", 6) == 0) {
            int sec = atoi(line + 6);
            sleep(sec);
        }
    }
    else if (line[0] == '@') {
        // @count = count + 1
        count++;
    }
}

int main() {
    char *script[] = {
        "/print(:Count is :Count)",
        "/wait(1)",
        "@count = count + 1",
        "/print(:Count is :Count)"
    };

    for (int i = 0; i < 4; i++) {
        interpret_line(script[i]);
    }

    return 0;
}
